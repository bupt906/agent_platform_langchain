DEFAULT_MODEL=deepseek:deepseek-chat

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Qwen (DashScope)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1

# MCP Config
MCP_CONFIG_PATH=mcp_config.json

# Service Config
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# 可靠性
REQUEST_TIMEOUT=120
MAX_RETRIES=2

# 安全 (空则不启用认证)
API_KEY=

# 限流 (每 IP 每分钟最大请求数，0=不限)
RATE_LIMIT_PER_MINUTE=60

# 声明式 Skills
DECLARATIVE_SKILLS_ENABLED=true
DECLARATIVE_SKILLS_MAX_TOOL_CALLS=10
PYTHON_SANDBOX_TIMEOUT=30

# ── 持久化记忆 ──
MEMORY_DB_PATH=memory.db
MEMORY_RETENTION_DAYS=90
AUTO_SUMMARIZE_THRESHOLD=10
SUMMARIZATION_MODEL=
ENABLE_PROFILE_PERSISTENCE=true

# ── 审计日志 ──
AUDIT_DB_PATH=audit.db
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_TOOL_CALLS=true
AUDIT_LOG_TOKEN_USAGE=true

# ── Prompt 缓存 ──
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_TTL=300

# ── Tool 优化 ──
TOOL_PARALLEL_EXECUTION=true
TOOL_TIMEOUT_SECONDS=30.0
TOOL_RATE_LIMIT_PER_MINUTE=100
TOOL_BUDGET_MAX_CALLS=50
MCP_DYNAMIC_RELOAD=true

# ── Human-in-the-loop ──
HITL_ENABLED=true
HITL_APPROVAL_TIMEOUT=300
HITL_SENSITIVE_SKILLS=["data_query", "contract_review"]
HITL_AUTO_APPROVE_LOW_RISK=false
