DEFAULT_MODEL=deepseek:deepseek-v4-pro

# DeepSeek (optional, kept for backward compatibility)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Qwen (DashScope)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1

# MCP Config
MCP_CONFIG_PATH=mcp_config.json

# Service Config
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# 可靠性
REQUEST_TIMEOUT=120
MAX_RETRIES=2

# 安全 (空则不启用认证)
API_KEY=

# 限流 (每 IP 每分钟最大请求数，0=不限)
RATE_LIMIT_PER_MINUTE=60

# 声明式 Skills
DECLARATIVE_SKILLS_ENABLED=true
DECLARATIVE_SKILLS_MAX_TOOL_CALLS=10
PYTHON_SANDBOX_TIMEOUT=30
FILE_READ_ALLOWED_ROOTS=.,/mnt/user-data/uploads # read_file 允许读取的目录，多个目录用逗号分隔
FILE_READ_MAX_CHARS=50000 # read_file 单次最多返回的字符数
FILE_READ_MAX_BYTES=10485760 # read_file 允许读取的最大文件大小（字节）
FILE_WRITE_ALLOWED_ROOTS=. # write_file 允许写入的目录，多个目录用逗号分隔
FILE_WRITE_MAX_BYTES=10485760 # write_file 单次允许写入的最大字节数
BASH_ALLOWED_ROOTS=. # bash 工具允许访问的目录，多个目录用逗号分隔
BASH_ALLOWED_COMMANDS=python,python3,pytest,ruff,ls,find,mkdir # bash 工具允许执行的命令名，多个命令用逗号分隔
BASH_DEFAULT_TIMEOUT_SECONDS=120 # bash 命令的默认超时秒数
BASH_MAX_TIMEOUT_SECONDS=300 # bash 命令允许设置的最大超时秒数
BASH_MAX_OUTPUT_CHARS=15000 # bash 命令的 stdout/stderr 单项最大保留字符数

# ── Skill 隔离运行时与产物 ──
SKILL_WORKSPACE_ROOT=.agent-platform/workspaces
SKILL_ARTIFACT_ROOT=.agent-platform/artifacts
SKILL_ARTIFACT_TTL_SECONDS=604800
SKILL_ARTIFACT_MAX_BYTES=52428800
SKILL_SANDBOX_ENGINE=docker
CAD_SKILL_ENABLED=true
CAD_RUNTIME_IMAGE=agent-platform/agentcad:0.4.0
CAD_RUNTIME_TIMEOUT_SECONDS=300
CAD_RUNTIME_MEMORY_MB=2048
CAD_RUNTIME_CPUS=2.0
CAD_RUNTIME_PIDS_LIMIT=64

# ── 持久化记忆 ──
MEMORY_DB_PATH=memory.db
MEMORY_RETENTION_DAYS=90
AUTO_SUMMARIZE_THRESHOLD=10
SUMMARIZATION_MODEL=
ENABLE_PROFILE_PERSISTENCE=true

# ── 审计日志 ──
AUDIT_DB_PATH=audit.db
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_TOOL_CALLS=true
AUDIT_LOG_TOKEN_USAGE=true

# ── Prompt 缓存 ──
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_TTL=300

# ── Tool 优化 ──
TOOL_PARALLEL_EXECUTION=true
TOOL_TIMEOUT_SECONDS=30.0
TOOL_RATE_LIMIT_PER_MINUTE=100
TOOL_BUDGET_MAX_CALLS=50
MCP_DYNAMIC_RELOAD=true

# ── Human-in-the-loop ──
HITL_ENABLED=true
HITL_APPROVAL_TIMEOUT=300
HITL_SENSITIVE_SKILLS=["data_query", "contract_review"]
HITL_AUTO_APPROVE_LOW_RISK=false

# ── 审阅回调 ──
CALLBACK_BASE_URL=
CALLBACK_AUTH_TOKEN=

# ── 外部知识库（万悟平台 hit 检索接口）──
# ── 知识库后端选择 ──────────────────────────────────────
# wanwu    = 万悟平台 hit 接口（见下方 KB_* 配置）
# omnimind = 知识库中台服务契约层（见下方 OMNIMIND_* 配置，需安装 kb-sdk）
# dual     = 两边都查、用 omnimind 的结果并记录差异，供迁移期比对
KNOWLEDGE_PROVIDER=wanwu

KB_API_BASE_URL=http://localhost:8081
KB_API_KEY=
KB_MATCH_TYPE=mix          # vector / text / mix
KB_RERANK_MODEL_ID=        # 重排序模型 UUID（mix 模式可选）
KB_PRIORITY_MATCH=0        # 权重匹配开关：0=关闭 1=开启
KB_SEMANTICS_PRIORITY=0.2  # 语义权重（KB_PRIORITY_MATCH=1 时生效）
KB_KEYWORD_PRIORITY=0.8    # 关键词权重（KB_PRIORITY_MATCH=1 时生效）
KB_TOP_K=5
KB_THRESHOLD=0.4
KB_USE_GRAPH=false
KB_REQUEST_TIMEOUT=30.0

# ── 知识库中台（KNOWLEDGE_PROVIDER=omnimind / dual 时生效）──
OMNIMIND_BASE_URL=http://localhost:8000
OMNIMIND_API_KEY=                 # 对应中台的 SERVICE_API_KEY
OMNIMIND_TOP_K=5
OMNIMIND_REQUEST_TIMEOUT=30.0
OMNIMIND_RETRIES=2
# 旧知识库 ID → 中台 UUID 映射，格式 "旧id:新id,旧id2:新id2"。
# 迁移期供仍在使用万悟数字串 ID 的外部调用方（如审阅任务下发方）使用。
OMNIMIND_KB_ID_MAP=
